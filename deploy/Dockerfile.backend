# Build stage: static binaries for api, worker, migrate, and audit-uploads.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN mkdir -p /out/uploads && chmod 750 /out/uploads
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/api ./cmd/api \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/worker ./cmd/worker \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/audit-uploads ./cmd/audit-uploads

# Runtime stage: distroless, one image for all four commands.
FROM gcr.io/distroless/static-debian12:nonroot
ARG APP_REVISION=development
ENV APP_REVISION=$APP_REVISION
COPY --from=build --chown=65532:65532 /out/uploads /uploads
COPY --from=build /out/api /out/worker /out/migrate /out/audit-uploads /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/api"]
